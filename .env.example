# Frontend env template — `musanif` (Dioxus).
#
# Read at compile time by `packages/ui/build.rs`. The build script picks
# `.env.{BUILD_PROFILE}` (default `.env.local`) and bakes the values into
# the binary via `cargo:rustc-env`. Re-run a build after editing.
#
# BUILD_PROFILE selects which file to load:
#   - unset / `local` → .env.local
#   - `prod`          → .env.prod

API_BASE_URL=http://localhost:9678/api/v1
GRAPHQL_URL=http://localhost:9678/api/graphql
# `development` | `production`. Available at runtime via
# `ui::config::app_env()`.
APP_ENV=development
